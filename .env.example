# Subsidy360 — optional connector configuration.
# Everything works with this file absent: the app runs from local JSON packs.
# No government endpoint is shipped or guessed — supply your own, officially
# published URL and your own API key where the portal issues one.

# myScheme — only if you have an officially published endpoint.
# Default and supported route is the file import: npm run import:myscheme
VITE_MYSCHEME_ENDPOINT=

# data.gov.in — from your registered account on the Open Government Data platform.
VITE_DATAGOV_ENDPOINT=
VITE_DATAGOV_KEY=
VITE_DATAGOV_RESOURCES=

# Load the synthetic load-test pack (NOT government data) to check UI scale.
VITE_LOADTEST=0

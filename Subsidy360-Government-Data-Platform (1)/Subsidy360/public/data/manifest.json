      "enabled": true
    },
    {
      "id": "state-gujarat",
      "kind": "schemes",
      "connector": "state-portals",
      "label": "Gujarat state portal pack (example)",
      "path": "data/states/gujarat.example.json",
      "enabled": true
    },
    {
      "id": "union-budget-demo",
      "kind": "budget",
      "connector": "union-budget",
      "label": "Union Budget pack (demonstration figures)",
      "path": "data/budget/union-budget.demo.json",
      "enabled": true
    }
  ]
}

{
  "manifestVersion": 1,
  "notice": "Subsidy360 pack manifest. Add a pack file to /public/data/<source>/ and register it here — the interface picks it up on reload with no code change.",
  "packs": [
    {
      "id": "schemes-catalogue",
      "kind": "schemes",
      "connector": "myscheme",
      "label": "National & State Schemes Catalogue",
      "path": "data/schemes.json",
      "enabled": true
    },
    {
      "id": "union-budget",
      "kind": "budget",
      "connector": "union-budget",
      "label": "Union Budget pack",
      "path": "data/budget/union-budget.json",
      "enabled": true
    }
  ]
}
